{
  "manifest_version": 3,
  "name": "Mexico Creator Finder Companion",
  "version": "0.5.0",
  "description": "在当前 Instagram 标签页中顺序发现和分析公开创作者。",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel", "tabs"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://www.instagram.com/*",
    "https://instagram.com/*"
  ],
  "action": {"default_title": "Mexico Creator Finder"},
  "background": {"service_worker": "background.js"},
  "side_panel": {"default_path": "sidepanel.html"},
  "content_scripts": [{"matches": ["https://www.instagram.com/*"], "js": ["content.js"], "run_at": "document_idle"}]
}
